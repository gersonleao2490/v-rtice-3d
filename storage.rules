rules_version = '2';

// Vértice 3D — regras do Storage
// Admin: vertice.renders3d@gmail.com
//
// As imagens (portfólio, logo) precisam de leitura pública, senão o site
// não consegue exibi-las. O envio e a exclusão são exclusivos do admin.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'Nq9Yg2d1Q4UNGBpJMTfK8odBzFk2';
    }
  }
}
